# Required. The server refuses to start without it.
# Generate one with: openssl rand -hex 24
API_KEY=

# Optional
PORT=3000
HOST=0.0.0.0

# How many browser jobs may run at once. Each costs a Chromium process and a
# few hundred MB, so raise this only if the host has the memory for it.
MAX_CONCURRENT_BROWSERS=15

# Optional proxy pool, comma or newline separated.
# http://user:pass@host:port, or host:port for an unauthenticated proxy.
# Left empty, requests connect directly.
PROXIES=
