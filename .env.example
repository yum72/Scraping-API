# Required. The server refuses to start without it.
# Generate one with: openssl rand -hex 24
API_KEY=

# Optional
PORT=3000
HOST=0.0.0.0

# ─── Queue ───────────────────────────────────────────────────────────────────
# Browser jobs allowed to run at once. Each is a Chromium process and a few
# hundred MB, so raise this only if the host has the memory. Requests past the
# limit queue rather than fail.
MAX_CONCURRENT_BROWSERS=15

# ─── Timeouts ────────────────────────────────────────────────────────────────
# One budget covers the whole request: queue wait, browser launch, navigation
# and content extraction. Callers set it per request with ?maxTimeout=, and
# these two decide what they get.

# Applied when a request does not ask for one.
DEFAULT_TIMEOUT_MS=120000

# Hard ceiling. A request asking for more is clamped down to this, so no caller
# can pin a browser for ten minutes. Clamped, not rejected; the reply carries
# effectiveTimeout so they can see what was enforced.
MAX_TIMEOUT_MS=300000

# ─── Proxies ─────────────────────────────────────────────────────────────────
# Two ways to supply a pool. Use the file for anything more than a couple.
# Leave both empty and requests go out directly.

# Path to a list, one proxy per line. Blank lines and # comments are ignored.
PROXIES_FILE=

# Or inline, comma or newline separated.
# Accepted: host:port, user:pass@host:port, http://..., socks5://...
PROXIES=
